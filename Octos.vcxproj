<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64;Release|x64;Debug|Win32;Release|Win32" />
  </ItemGroup>

  <PropertyGroup>
    <Configuration Condition="'$(Configuration)'==''">Debug</Configuration>
    <Platform Condition="'$(Platform)'==''">x64</Platform>
  </PropertyGroup>

  <PropertyGroup Label="Globals">
    <ProjectGuid>{B2DE8C60-7E6F-4E56-B672-FE716F0F512F}</ProjectGuid>
    <RootNamespace>Octos</RootNamespace>
    <VcpkgEnabled>true</VcpkgEnabled>
    <VcpkgEnableManifest>true</VcpkgEnableManifest>
    <WindowsTargetPlatformVersion>10.0.26100.0</WindowsTargetPlatformVersion>
    <AppVersion>1.0.0.0</AppVersion>
    <!-- <VcpkgTriplet Condition="'$(Platform)'=='x64'">x64-windows</VcpkgTriplet>
    <VcpkgTriplet Condition="'$(Platform)'=='Win32'">x86-windows</VcpkgTriplet> -->
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="Configuration">
    <OutDir>$(ProjectDir)build\$(Platform)\$(Configuration)\</OutDir>
    <OutFolder>$(ProjectDir)build\$(Platform)\$(Configuration)</OutFolder> <!--No
    trailing slash-->
    <IntDir>$(ProjectDir)build\intermediate\$(Platform)\$(Configuration)\</IntDir>
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>v143</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <!-- <Target Name="RunAppLocal" BeforeTargets="Build">
    <Exec
      Command="powershell.exe -ExecutionPolicy Bypass -File
  &quot;$(VcpkgRoot)\scripts\buildsystems\msbuild\applocal.ps1&quot; &quot;$(TargetPath)&quot;
  &quot;$(VcpkgManifestRoot)\vcpkg_installed\$(VcpkgTriplet)&quot;" />
  </Target> -->

  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <PreprocessorDefinitions>WEBVIEW2_NO_IDL;UNICODE;_UNICODE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <AdditionalOptions>/FS %(AdditionalOptions)</AdditionalOptions>
      <RuntimeLibrary>MultiThreadedDebugDLL</RuntimeLibrary> <!-- /MDd -->
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <AdditionalDependencies>
        ole32.lib;uuid.lib;user32.lib;shlwapi.lib;dcomp.lib;d3d11.lib;shell32.lib;
        comctl32.lib;advapi32.lib;urlmon.lib;windowsapp.lib;Crypt32.lib;
        %(AdditionalDependencies)
      </AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <PreprocessorDefinitions>WEBVIEW2_NO_IDL;UNICODE;_UNICODE;NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <AdditionalOptions>/FS %(AdditionalOptions)</AdditionalOptions>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary> <!-- /MD -->
      <Optimization>MaxSpeed</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
      <AdditionalDependencies>
        ole32.lib;uuid.lib;user32.lib;shlwapi.lib;dcomp.lib;d3d11.lib;shell32.lib;
        comctl32.lib;advapi32.lib;urlmon.lib;windowsapp.lib;Crypt32.lib;
        %(AdditionalDependencies)
      </AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="src\**\*.cpp" />
  </ItemGroup>

  <ItemGroup>
    <ResourceCompile Include="assets\icon.rc" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />

  <Target Name="CopyAssets" AfterTargets="Build" DependsOnTargets="PrepareForBuild">
    <Message Text="Copying assets to output directory..." />
    <MakeDir Directories="$(OutDir)" />
    <ItemGroup>
      <AssetFiles Include="$(ProjectDir)assets\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(AssetFiles)" DestinationFolder="$(OutDir)%(RecursiveDir)"
      SkipUnchangedFiles="false" />
  </Target>

  <!-- <Target Name="PrintVcpkgRoot" BeforeTargets="Build">
    <Message
      Text="hi $(VcpkgManifestRoot)\vcpkg_installed\$(VcpkgTriplet)\bin\*.dll $(VcpkgInstalledDir)"
      Importance="high" />
  </Target> -->

  <Target Name="CopyVcpkgDlls" AfterTargets="Build">
    <Message
      Text="Copying vcpkg DLLs... $(VcpkgManifestRoot)\vcpkg_installed\$(VcpkgTriplet)\bin\*.dll"
      Importance="high" />
    <ItemGroup>
      <VcpkgDlls Include="$(VcpkgManifestRoot)\vcpkg_installed\$(VcpkgTriplet)\bin\*.dll" />
      <NestedVcpkgDlls
        Include="$(VcpkgManifestRoot)\vcpkg_installed\$(VcpkgTriplet)\$(VcpkgTriplet)\bin\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(VcpkgDlls)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="false" />
    <Copy SourceFiles="@(NestedVcpkgDlls)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="false" />
  </Target>

  <Target Name="CleanDebugFiles" AfterTargets="CopyVcpkgDlls"
    Condition="'$(Configuration)'=='Release'">
    <ItemGroup>
      <FilesToDelete
        Include="$(OutDir)**\*.pdb;$(OutDir)**\*.ilk;$(OutDir)**\*.exp;$(OutDir)**\*.lib" />
    </ItemGroup>
    <Delete Files="@(FilesToDelete)" ContinueOnError="true" />
    <Message Text="Built to $(OutDir)" Importance="high"></Message>
  </Target>

  <PropertyGroup>
    <AppxManifest>$(ProjectDir)assets\AppxManifest.xml</AppxManifest>
    <Namespaces>
      <Namespace Prefix="x" Uri="http://schemas.microsoft.com/appx/manifest/foundation/windows10" />
    </Namespaces>
    <BundlePlatforms>x86;x64</BundlePlatforms>
    <AppxPackageDir>$(ProjectDir)build\Appx</AppxPackageDir>
    <OutAppx>$(AppxPackageDir)\OctosSetup_$(Platform).msix</OutAppx>
    <OutAppxBundle>$(ProjectDir)build\OctosSetup.msixbundle</OutAppxBundle>
  </PropertyGroup>

  <Target Name="MakeAppx" DependsOnTargets="Build;CopyAssets;CopyVcpkgDlls;CleanDebugFiles">
    <Message Text="Creating MSIX from $(OutDir)..." Importance="high" />
    <Delete Files="$(OutAppx)" ContinueOnError="true" />
    <XmlPoke XmlInputPath="$(AppxManifest)"
      Query="/x:Package/x:Identity/@Version"
      Value="$(AppVersion)"
      Namespaces="$(Namespaces)">
    </XmlPoke>
    <PropertyGroup>
      <MSIXArch Condition="'$(Platform)'=='Win32'">x86</MSIXArch>
      <MSIXArch Condition="'$(Platform)'=='x64'">x64</MSIXArch>
    </PropertyGroup>
    <XmlPoke XmlInputPath="$(AppxManifest)"
      Query="/x:Package/x:Identity/@ProcessorArchitecture"
      Value="$(MSIXArch)"
      Namespaces="$(Namespaces)">
    </XmlPoke>
    <Exec Command="powershell -Command &quot;Start-Sleep -Seconds 2&quot;" />
    <Exec Command="MakeAppx.exe pack /d &quot;$(OutFolder)&quot; /p &quot;$(OutAppx)&quot;" />
    <!-- <Exec Command="signtool sign /a /fd SHA256 /tr http://timestamp.digicert.com /td SHA256
    &quot;$(OutAppx)&quot;" /> -->
    <Message Text="MSIX created at $(OutAppx)" Importance="high" />
  </Target>

  <Target Name="BundleAppx">
    <Delete Files="$(OutAppxBundle)" ContinueOnError="true" />
    <Message Text="Creating MSIXBundle for all supported platforms..." Importance="high" />
    <MSBuild Projects="$(MSBuildProjectFile)" Targets="MakeAppx"
      Properties="Platform=x64;Configuration=Release" />
    <MSBuild Projects="$(MSBuildProjectFile)" Targets="MakeAppx"
      Properties="Platform=x86;Configuration=Release" />
    <Exec
      Command="MakeAppx.exe bundle /d &quot;$(AppxPackageDir)&quot; /p &quot;$(OutAppxBundle)&quot;" />
    <!-- <Exec Command="signtool sign /a /fd SHA256 /tr http://timestamp.digicert.com /td SHA256
    &quot;$(OutAppxBundle)&quot;" /> -->
    <Message Text="MSIXBundle created at $(OutAppxBundle)" Importance="high" />
  </Target>

  <Target Name="InnoSetup">
    <Message Text="Creating startup executable for all supported platforms..." Importance="high" />
    <MSBuild Projects="$(MSBuildProjectFile)" Targets="Build"
      Properties="Platform=x64;Configuration=Release" />
    <MSBuild Projects="$(MSBuildProjectFile)" Targets="Build"
      Properties="Platform=x86;Configuration=Release" />
    <Exec Command="powershell -Command &quot;Start-Sleep -Seconds 2&quot;" />
    <Exec Command="iscc.exe /dAppVersion=$(AppVersion) $(ProjectDir)OctosSetup.iss" />
    <Message Text="Setup EXE created at $(ProjectDir)build\OctosSetup.exe" Importance="high" />
  </Target>

</Project>