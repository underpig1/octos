<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <ProjectGuid>{B2DE8C60-7E6F-4E56-B672-FE716F0F512F}</ProjectGuid>
    <RootNamespace>Octos</RootNamespace>
    <VcpkgEnabled>true</VcpkgEnabled>
    <VcpkgEnableManifest>true</VcpkgEnableManifest>
    <WindowsTargetPlatformVersion>10.0.26100.0</WindowsTargetPlatformVersion>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup>
    <Configuration Condition="'$(Configuration)'==''">Debug</Configuration>
    <Platform Condition="'$(Platform)'==''">x64</Platform>
  </PropertyGroup>

  <PropertyGroup Label="Configuration">
    <OutDir>$(ProjectDir)build\$(Configuration)\</OutDir>
    <IntDir>$(ProjectDir)build\intermediate\$(Configuration)\</IntDir>
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>v143</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <!-- <Target Name="RunAppLocal" BeforeTargets="Build">
    <Exec
      Command="powershell.exe -ExecutionPolicy Bypass -File &quot;$(VcpkgRoot)\scripts\buildsystems\msbuild\applocal.ps1&quot; &quot;$(TargetPath)&quot; &quot;$(VcpkgManifestRoot)\vcpkg_installed\$(VcpkgTriplet)&quot;" />
  </Target> -->

  <PropertyGroup>
    <IncludePath>$(IncludePath);$(VcpkgIncludeDirectories)</IncludePath>
    <LibraryPath>$(LibraryPath);$(VcpkgLibraryDirectories)</LibraryPath>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <PreprocessorDefinitions>WEBVIEW2_NO_IDL;UNICODE;_UNICODE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <AdditionalOptions>/FS %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <AdditionalDependencies>
        ole32.lib;uuid.lib;user32.lib;shlwapi.lib;dcomp.lib;d3d11.lib;shell32.lib;
        comctl32.lib;advapi32.lib;urlmon.lib;windowsapp.lib;Crypt32.lib;
        %(AdditionalDependencies)
      </AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="src\**\*.cpp" />
  </ItemGroup>

  <ItemGroup>
    <ResourceCompile Include="assets\icon.rc" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />

  <Target Name="CopyAssets" AfterTargets="Build" DependsOnTargets="PrepareForBuild">
    <Message Text="Copying assets to output directory..." />
    <MakeDir Directories="$(OutDir)" />
    <ItemGroup>
      <AssetFiles Include="$(ProjectDir)assets\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(AssetFiles)" DestinationFolder="$(OutDir)%(RecursiveDir)"
      SkipUnchangedFiles="false" />
  </Target>

  <!-- <Target Name="PrintVcpkgRoot" BeforeTargets="Build">
    <Message
      Text="hi $(VcpkgManifestRoot)\vcpkg_installed\$(VcpkgTriplet)\bin\*.dll $(VcpkgInstalledDir)"
      Importance="high" />
  </Target> -->

  <Target Name="CopyVcpkgDlls" AfterTargets="Build">
    <Message Text="Copying vcpkg DLLs... $(VcpkgManifestRoot)\vcpkg_installed\$(VcpkgTriplet)\bin\*.dll" Importance="high" />
    <ItemGroup>
      <VcpkgDlls Include="$(VcpkgManifestRoot)\vcpkg_installed\$(VcpkgTriplet)\bin\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(VcpkgDlls)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="false" />
  </Target>

  <PropertyGroup>
    <AppxManifest>$(ProjectDir)assets\AppxManifest.xml</AppxManifest>
    <AppxBundle>Always</AppxBundle>
  </PropertyGroup>

  <ItemGroup>
    <FilesToDelete Include="$(OutDir)**\*.pdb;$(OutDir)**\*.ilk;$(OutDir)**\*.exp;$(OutDir)**\*.lib" />
  </ItemGroup>

  <Target Name="MakeAppx" DependsOnTargets="Build;CopyAssets;CopyVcpkgDlls">
    <Message Text="Creating MSIX/MSIXBundle from $(OutDir)..." Importance="high" />
    <Delete Files="@(FilesToDelete)" />
    <Exec Command="MakeAppx.exe pack /d &quot;$(ProjectDir)build\$(Configuration)&quot; /p &quot;$(ProjectDir)build\OctosSetup.msix&quot;" />
    <Message Text="MSIX created at $(OutDir)OctosSetup.msix" Importance="high" />
  </Target>

  <Target Name="InnoSetup" DependsOnTargets="Build;CopyAssets;CopyVcpkgDlls">
    <Message Text="Creating startup executable from $(OutDir)..." Importance="high" />
    <Delete Files="@(FilesToDelete)" />
    <Exec Command="iscc.exe $(ProjectDir)OctosSetup.iss" />
    <Message Text="Setup EXE created at $(OutDir)OctosSetup.exe" Importance="high" />
  </Target>

</Project>