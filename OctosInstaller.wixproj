<Project DefaultTargets="BuildInstaller" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

    <PropertyGroup>
        <Configuration Condition="'$(Configuration)'==''">Release</Configuration>
        <OutputName>OctosInstaller</OutputName>
        <!-- Use WiX environment variable if available, fallback to default path -->
        <WixTargetsPath Condition="'$(WixTargetsPath)'==''">C:\Program Files (x86)\WiX Toolset v3.14\bin</WixTargetsPath>
        <CandlePath>$(WixTargetsPath)\candle.exe</CandlePath>
        <LightPath>$(WixTargetsPath)\light.exe</LightPath>
        <HeatPath>$(WixTargetsPath)\heat.exe</HeatPath>
        <ObjDir>obj\$(Configuration)</ObjDir>
    </PropertyGroup>

    <ItemGroup>
        <Wix Include="Octos.wxs" />
    </ItemGroup>

    <Target Name="GenerateAssetsWxs">
        <Message Text="Generating Assets.wxs with Heat..." Importance="high" />
        <MakeDir Directories="$(ObjDir)" />
        <Exec
            Command="&quot;$(HeatPath)&quot; dir &quot;assets&quot; -cg AssetsComponents -dr AssetsDir -srd -var var.AssetsDir -out &quot;$(ObjDir)\Assets.wxs&quot;"
            ContinueOnError="false" />
    </Target>

    <ItemGroup>
        <Wix Include="$(ObjDir)\Assets.wxs" />
    </ItemGroup>

    <Target Name="BuildInstaller" DependsOnTargets="GenerateAssetsWxs">
        <Exec
            Command="&quot;$(CandlePath)&quot; -out &quot;$(ObjDir)\&quot; &quot;Octos.wxs&quot; &quot;$(ObjDir)\Assets.wxs&quot;" />
        <Exec
            Command="&quot;$(LightPath)&quot; -out &quot;$(OutputName).msi&quot; &quot;$(ObjDir)\Octos.wixobj&quot; &quot;$(ObjDir)\Assets.wixobj&quot;" />
    </Target>

</Project>